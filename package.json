{
  "name": "opoprobability",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test:a11y": "npm run build && playwright test",
    "test:a11y:lighthouse": "npm run build && node scripts/lighthouse-a11y.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "description": "Hypergeometric probability calculator for competitive-exam topic draws",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md,html,yml}": "prettier --write",
    "*.{ts,tsx}": "oxlint"
  }
}
